---
import Badge from "@components/shared/Badge.astro";
import { MAC_PROCESSORS } from "@data/Mac";
import type { BadgeType } from "@interfaces/Badge";
import type { MacProcessor } from "@interfaces/Mac";
import MainLayout from "@layouts/MainLayout.astro";

const macProcessors: MacProcessor[] = MAC_PROCESSORS;

const categoryMap: Record = {
  yes: 'success',
  no: 'secondary',
}
---

<MainLayout>
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Modelo</th>
        <th>Familia de chip</th>
        <th>Núcleos CPU</th>
        <th>Núcleos GPU</th>
        <th>Frecuencia máx.</th>
        <th>Proceso</th>
        <th>Año</th>
        <th>Media Engine</th>
      </tr>
    </thead>
    <tbody>
      {macProcessors.map((processor) => (
        <tr>
          <td>{ processor.id }</td>
          <td>{ processor.model }</td>
          <td>{ processor.chipFamily }</td>
          <td>{ processor.cores }</td>
          <td>{ processor.gpuCores }</td>
          <td>{ processor.maxClockGHz } GHz</td>
          <td>{ processor.process }</td>
          <td>{ processor.releaseYear }</td>
          <td>
            <Badge
              text={processor.hasMediaEngine ? 'Sí' : 'No'}
              type={categoryMap[processor.hasMediaEngine ? 'yes' : 'no']}
            />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</MainLayout>
