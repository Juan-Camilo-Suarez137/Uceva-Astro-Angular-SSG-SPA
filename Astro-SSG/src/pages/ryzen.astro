---
import Badge from "@components/shared/Badge.astro";
import { RYZEN_PROCESSORS } from "@data/Ryzen";
import type { BadgeType } from "@interfaces/Badge";
import type { RyzenProcessor } from "@interfaces/Ryzen";
import MainLayout from "@layouts/MainLayout.astro";

const ryzenProcessors: RyzenProcessor[] = RYZEN_PROCESSORS;

const categoryMap: Record<'integrated' | 'none', BadgeType> = {
  integrated: 'success',  
  none: 'secondary',
}
---
<MainLayout>
  <table class="table table-striped table-hover align-middle">
	<thead>
		<tr>
			<th>ID</th>
			<th>Modelo</th>
			<th>Arquitectura</th>
			<th>Núcleos</th>
			<th>Hilos</th>
			<th>Frecuencia máx.</th>
			<th>Socket</th>
			<th>Año</th>
			<th>Gráficos integrados</th>
		</tr>
	</thead>
	<tbody>
		{ryzenProcessors.map((processor) => (
            <tr>
				<td>{ processor.releaseYear }</td>
				<td>{ processor.model }</td>
				<td>{ processor.architecture }</td>
				<td>{ processor.cores }</td>
				<td>{ processor.threads }</td>
				<td>{ processor.maxBoostGHz } GHz</td>
				<td>{ processor.socket }</td>
                <td>{ processor.id }</td>
				<td>
                    <Badge
                        text={processor.hasIntegratedGraphics ? 'Sí' : 'No'}
                        type={categoryMap[processor.hasIntegratedGraphics ? 'integrated' : 'none']}
                    />
                </td>
            </tr>
        ))}
	</tbody>
</table>

</MainLayout>